APP_NAME="Marketplace API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# HTTP is served by nginx; configure BACKEND_PORT in the root .env.
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Docker Compose supplies the connection credentials at runtime.
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=marketplace_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,localhost:8000,127.0.0.1:8080,127.0.0.1:5173,127.0.0.1:8000

CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Enable only for this clearly labelled demo; no real payment provider is used.
DEMO_PAYMENTS_ENABLED=true
KEY_FINGERPRINT_SECRET=
