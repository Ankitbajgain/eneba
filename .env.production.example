COMPOSE_PROJECT_NAME=eneba-release
RELEASE_HTTP_PORT=9080
APP_URL=https://your-service.onrender.com
# Generate once, preserve and back up. Never use these blank values in a release.
APP_KEY=
KEY_FINGERPRINT_SECRET=
POSTGRES_DATABASE=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
# Set to the actual public hostname (without https://), including port if needed.
SANCTUM_STATEFUL_DOMAINS=your-service.onrender.com
DEMO_PAYMENTS_ENABLED=true
# Set only to verified proxy addresses; a platform-specific value may be required.
TRUSTED_PROXIES=
PHP_IMAGE=php:8.3-fpm-bookworm
NODE_IMAGE=node:slim
POSTGRES_IMAGE=postgres:17-bookworm
DATABASE_ADMIN_PORT=8888
ADMINER_IMAGE=adminer:standalone
