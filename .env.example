COMPOSE_PROJECT_NAME=eneba
HTTP_PORT=8080
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Empty means host-only cookies, supporting localhost and 127.0.0.1 separately.
SESSION_DOMAIN=
MYSQL_DATABASE=marketplace
MYSQL_USER=marketplace
# Local development only. Replace before starting a shared environment.
MYSQL_PASSWORD=local-marketplace-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
# Latest stable Node image at build time, per the requested stack.
NODE_IMAGE=node:slim
PHP_IMAGE=php:8.3-fpm-bookworm
MYSQL_IMAGE=mysql:8.4
NGINX_IMAGE=nginx:stable-alpine
