# Add these variables to Render environment settings. Keep real values private.
PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service.onrender.com
APP_KEY=
KEY_FINGERPRINT_SECRET=
DB_CONNECTION=pgsql
# Render injects the eneba-postgres private hostname and generated credentials.
DB_HOST=
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=marketplace_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=your-service.onrender.com
CACHE_STORE=database
CACHE_LIMITER=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DEMO_PAYMENTS_ENABLED=true
# Render is the only public ingress; it supplies forwarded request metadata.
TRUSTED_PROXIES=*
DB_SSLMODE=require
