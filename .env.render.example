# Copy to an ignored .env.render file for a manual Render import.
# Fill the placeholders privately and preserve existing production keys.
PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service.onrender.com
APP_KEY=
KEY_FINGERPRINT_SECRET=
DB_CONNECTION=pgsql
# Use Postgres > Connect > Internal Database URL. Blueprint sync sets this automatically.
DB_URL=
SESSION_DRIVER=database
SESSION_COOKIE=marketplace_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=your-service.onrender.com
CACHE_STORE=database
CACHE_LIMITER=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DEMO_PAYMENTS_ENABLED=true
# Render is the only public ingress; it supplies forwarded request metadata.
TRUSTED_PROXIES=*
DB_SSLMODE=require
