# Add these variables to Vercel Production settings. Keep real values private.
PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_KEY=
KEY_FINGERPRINT_SECRET=
DB_CONNECTION=mysql
# Railway PUBLIC TCP proxy host/port, not railway.internal.
DB_HOST=
DB_PORT=
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=
# Base64 PEM of the database CA, verified against the public database hostname.
MYSQL_SSL_CA_BASE64=
SESSION_DRIVER=database
SESSION_COOKIE=marketplace_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=your-project.vercel.app
CACHE_STORE=database
CACHE_LIMITER=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DEMO_PAYMENTS_ENABLED=true
# Vercel is the only public ingress; it supplies forwarded request metadata.
TRUSTED_PROXIES=*
